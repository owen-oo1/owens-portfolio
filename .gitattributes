# Enforce LF for all text files
* text=auto eol=lf

# Ensure JSON and JS always use LF
*.js  text eol=lf
*.jsx text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# CSS and HTML should use LF
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# Windows-specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files should never be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
